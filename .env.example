# ===========================================
# Fēi (飞) — Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your keys.
# .env.local is git-ignored so your keys stay private.
#
# To get these keys:
# - Claude: https://console.anthropic.com/settings/keys
# - DeepSeek: https://platform.deepseek.com/api_keys
# - Qwen: https://dashscope.console.aliyun.com/
# - Supabase: https://supabase.com/dashboard → Project Settings → API
# ===========================================

# Claude API (primary AI)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# DeepSeek API (Chinese-source AI, primary)
DEEPSEEK_API_KEY=sk-xxxxx

# Qwen API (Chinese-source AI, backup) — leave blank until ready
QWEN_API_KEY=

# Supabase (database)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx
